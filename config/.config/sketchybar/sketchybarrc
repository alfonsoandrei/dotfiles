#!/bin/bash
# SketchyBar, Rosé Pine Moon. Started by AeroSpace (after-startup-command).

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"
export PATH="/opt/homebrew/bin:$PATH"

FONT="JetBrainsMono Nerd Font"

sketchybar --bar display=all position=top height=32 blur_radius=20 color="$BAR" \
  margin=8 y_offset=4 corner_radius=10 padding_left=6 padding_right=6

sketchybar --default \
  icon.font="$FONT:Bold:14.0" icon.color="$TEXT" \
  label.font="$FONT:Bold:13.0" label.color="$TEXT" \
  padding_left=4 padding_right=4 \
  icon.padding_left=6 icon.padding_right=4 label.padding_left=4 label.padding_right=6

# Workspaces: one hidden item per AeroSpace workspace; plugins/aerospace.sh shows
# the focused one (iris) and the ones that have windows (overlay).
sketchybar --add event aerospace_workspace_change
for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" drawing=off \
      label="$sid" icon.drawing=off \
      label.padding_left=10 label.padding_right=10 \
      background.corner_radius=7 background.height=22 background.drawing=on \
      click_script="aerospace workspace $sid"
done

sketchybar --add item aerospace left \
  --set aerospace drawing=off updates=on script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe aerospace aerospace_workspace_change front_app_switched space_windows_change system_woke display_change

sketchybar --add item front_app left \
  --set front_app icon.drawing=off label.color="$IRIS" padding_left=12 script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock icon=󰥔 icon.color="$FOAM" update_freq=30 script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --set battery icon.color="$GOLD" update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

# Aliases of these apps' menu bar icons render blank on this macOS, so use themed status items instead.
sketchybar --add item granola right \
  --set granola label.drawing=off update_freq=5 script="$PLUGIN_DIR/granola.sh" click_script="open -a Granola"

sketchybar --add item vpn right \
  --set vpn label.drawing=off update_freq=10 script="$PLUGIN_DIR/vpn.sh" \
    click_script="open -a 'AWS VPN Client'" \
  --subscribe vpn system_woke

sketchybar --update

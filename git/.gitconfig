[diff]
    tool = nvim
    algorithm = histogram
[difftool "nvim"]
    cmd = NVIM_APPNAME=nvim-lite nvim -d "$LOCAL" "$REMOTE"
[merge]
    tool = codediff
    gpgSign = true
    conflictStyle = zdiff3
[mergetool]
    keepBackup = false
[mergetool "codediff"]
    cmd = NVIM_APPNAME=nvim-lite nvim \"$MERGED\" -c \"CodeDiff --exit-on-close merge \\\"$MERGED\\\"\"
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rerere]
    enabled = true
[gpg]
    program = gpg
[commit]
    gpgSign = true
[url "git@bitbucket.org:"]
    insteadOf = https://bitbucket.org/
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

# User identity is machine-specific — set it in ~/.gitconfig.local
# Keep this include last so local overrides can disable defaults like gpgSign.
[include]
    path = ~/.gitconfig.local

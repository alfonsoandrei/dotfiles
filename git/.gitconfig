# User identity is machine-specific — set it in ~/.gitconfig.local
# See git/.gitconfig.local.example for a template.
[include]
    path = ~/.gitconfig.local

[diff]
    tool = nvim
    algorithm = histogram
[difftool "nvim"]
    cmd = nvim -d "$LOCAL" "$REMOTE"
[merge]
    tool = nvim
    gpgSign = true
    conflictStyle = zdiff3
[mergetool "nvim"]
    cmd = nvim -d $LOCAL $REMOTE $BASE $MERGED
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rerere]
    enabled = true
[gpg]
    program = gpg2
[commit]
    gpgSign = true
[url "git@bitbucket.org:"]
    insteadOf = https://bitbucket.org/
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
